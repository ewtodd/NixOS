+
+// Development aid for quantization studies: GUFO_GGUF_OVERLAY=FILE[:FILE...]
+// (each FILE a single GGUF or the first shard of a split set) replaces the
+// same-named tensors of every opened model with the overlay's copies, so a
+// variant is assembled from existing files instead of rewriting them.
+// GUFO_GGUF_OVERLAY_FILTER (ECMAScript regex) limits which overlay tensors take
+// part. Tensors the base lacks are ignored, so predictor, vision and tokenizer
+// readers are unaffected. Weight binding locates a tensor by address across
+// GetMappedRegions(), so the overlay's regions are appended to the base's.
+std::unique_ptr<GgufReader> GgufReader::ApplyOverlayEnv(
+    std::unique_ptr<GgufReader> base, std::string* error_msg) {
+  const char* env = std::getenv("GUFO_GGUF_OVERLAY");
+  if (env == nullptr || *env == '\0') {
+    return base;
+  }
+  std::optional<std::regex> filter;
+  if (const char* f = std::getenv("GUFO_GGUF_OVERLAY_FILTER");
+      f != nullptr && *f != '\0') {
+    filter.emplace(f);
+  }
+  std::vector<std::unique_ptr<GgufReader>> overlays;
+  std::string_view list{env};
+  while (!list.empty()) {
+    const auto colon = list.find(':');
+    const std::string item{list.substr(0, colon)};
+    list = colon == std::string_view::npos ? std::string_view{}
+                                           : list.substr(colon + 1);
+    if (item.empty()) {
+      continue;
+    }
+    auto overlay = OpenFileOrSplitSet(item, error_msg);
+    if (!overlay) {
+      return nullptr;
+    }
+    overlays.push_back(std::move(overlay));
+  }
+
+  auto combined = std::unique_ptr<GgufReader>(new GgufReader());
+  combined->version_ = base->version_;
+  combined->alignment_ = base->alignment_;
+  combined->metadata_ = base->metadata_;
+  combined->size_ = base->size_;
+  combined->tensors_ = base->tensors_;
+  combined->tensor_index_ = base->tensor_index_;
+  combined->mapped_regions_ = base->mapped_regions_;
+  std::size_t replaced = 0;
+  for (const auto& overlay : overlays) {
+    combined->mapped_regions_.insert(combined->mapped_regions_.end(),
+                                     overlay->mapped_regions_.begin(),
+                                     overlay->mapped_regions_.end());
+    for (const auto& tensor : overlay->tensors_) {
+      const auto it = combined->tensor_index_.find(tensor.name);
+      if (it == combined->tensor_index_.end() ||
+          (filter && !std::regex_search(std::string(tensor.name), *filter))) {
+        continue;
+      }
+      combined->tensors_[it->second] = tensor;
+      ++replaced;
+    }
+  }
+  std::fprintf(stderr, "gguf overlay: %zu tensors replaced from %zu file(s)\n",
+               replaced, overlays.size());
+  combined->shards_.push_back(std::move(base));
+  for (auto& overlay : overlays) {
+    combined->shards_.push_back(std::move(overlay));
+  }
+  return combined;
+}
