# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];
  services.fwupd = {
    enable = true;
  };

  powerManagement = {
    enable = true;
    powertop.enable = false;
  };

  services.lact.settings = {
    version = 7;
    daemon = {
      log_level = "info";
      admin_group = "wheel";
      disable_clocks_cleanup = false;
    };
    apply_settings_timer = 5;
    gpus."1002:7551-F111:000A-0000:c7:00.0" = {
      fan_control_enabled = false;
      power_cap = 230.0;
    };
    gpus."1002:7551-F111:000A-0000:cc:00.0" = {
      fan_control_enabled = false;
      power_cap = 230.0;
    };
  };

  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "thunderbolt"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/c6abb1e6-dbb4-4a6c-82ff-bba33260da68";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/D3A7-AFC2";
    fsType = "vfat";
    options = [
      "fmask=0022"
      "dmask=0022"
    ];
  };

  fileSystems."/scratch" = {
    device = "/dev/disk/by-uuid/f46e3380-8258-451c-a4dd-7ef5f3dff939";
    fsType = "ext4";
  };

  # 6x Micron 1100 256GB on the ASM1166: two 3-drive RAID 0 arrays (unholy's SSD
  # stream pool and the dev workspace)
  boot.swraid = {
    enable = true;
    mdadmConf = ''
      MAILADDR root
      ARRAY /dev/md/stream metadata=1.2 UUID=77ee4b1d:cf5e9b59:a68e7ab2:094e5110
      ARRAY /dev/md/work metadata=1.2 UUID=b2d2f1c0:bb40cd9c:64ae0989:24df0d8e
    '';
  };

  fileSystems."/stream" = {
    device = "/dev/disk/by-label/stream";
    fsType = "ext4";
    options = [
      "nofail"
      "noatime"
      "x-systemd.device-timeout=10s"
    ];
  };

  fileSystems."/work" = {
    device = "/dev/disk/by-label/work";
    fsType = "ext4";
    options = [
      "nofail"
      "noatime"
      "x-systemd.device-timeout=10s"
    ];
  };

  swapDevices = [
    {
      device = "/var/swap";
      size = 32768;
      priority = 10;
    }
  ];
  systemd.settings.Manager = {
    RuntimeWatchdogSec = "30s";
    RebootWatchdogSec = "10min";
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
